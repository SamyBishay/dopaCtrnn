	keywords = {canonical direct and indirect basal ganglia pathways, mood and movement control, pallidum, Parkinson's disease, striatum, striosome},
	file = {Full Text PDF:files/33/Graybiel - 2025 - Surprises From the Basal Ganglia Stop and Go Have New Meaning.pdf:application/pdf;Snapshot:files/34/mds.html:text/html},
