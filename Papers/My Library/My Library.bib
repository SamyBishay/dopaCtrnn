@article{gerfen_segregation_2023,
	title = {Segregation of D1 and D2 dopamine receptors in the striatal direct and indirect pathways: An historical perspective},
	volume = {14},
	issn = {1663-3563},
	url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC9892636/},
	doi = {10.3389/fnsyn.2022.1002960},
	shorttitle = {Segregation of D1 and D2 dopamine receptors in the striatal direct and indirect pathways},
	abstract = {The direct and indirect striatal pathways form a cornerstone of the circuits of the basal ganglia. Dopamine has opponent affects on the function of these pathways due to the segregation of the D1- and D2-dopamine receptors in the spiny projection neurons giving rise to the direct and indirect pathways. An historical perspective is provided on the discovery of dopamine receptor segregation leading to models of how the direct and indirect affect motor behavior.},
	pages = {1002960},
	journaltitle = {Frontiers in Synaptic Neuroscience},
	shortjournal = {Front Synaptic Neurosci},
	author = {Gerfen, Charles R.},
	urldate = {2026-04-24},
	date = {2023-01-19},
