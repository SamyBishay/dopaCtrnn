@article{greenstreet_dopaminergic_2025,
	title = {Dopaminergic action prediction errors serve as a value-free teaching signal},
	volume = {643},
	rights = {2025 The Author(s)},
	issn = {1476-4687},
	url = {https://www.nature.com/articles/s41586-025-09008-9},
	doi = {10.1038/s41586-025-09008-9},
	abstract = {Choice behaviour of animals is characterized by two main tendencies: taking actions that led to rewards and repeating past actions1,2. Theory suggests that these strategies may be reinforced by different types of dopaminergic teaching signals: reward prediction error to reinforce value-based associations and movement-based action prediction errors to reinforce value-free repetitive associations3–6. Here we use an auditory discrimination task in mice to show that movement-related dopamine activity in the tail of the striatum encodes the hypothesized action prediction error signal. Causal manipulations reveal that this prediction error serves as a value-free teaching signal that supports learning by reinforcing repeated associations. Computational modelling and experiments demonstrate that action prediction errors alone cannot support reward-guided learning, but when paired with the reward prediction error circuitry they serve to consolidate stable sound–action associations in a value-free manner. Together we show that there are two types of dopaminergic prediction errors that work in tandem to support learning, each reinforcing different types of association in different striatal areas.},
	pages = {1333--1342},
	number = {8074},
	journaltitle = {Nature},
	publisher = {Nature Publishing Group},
	author = {Greenstreet, Francesca and Vergara, Hernando Martinez and Johansson, Yvonne and Pati, Sthitapranjya and Schwarz, Laura and Lenzi, Stephen C. and Geerts, Jesse P. and Wisdom, Matthew and Gubanova, Alina and Rollik, Lars B. and Kaur, Jasvin and Moskovitz, Theodore and Cohen, Joseph and Thompson, Emmett and Margrie, Troy W. and Clopath, Claudia and Stephenson-Jones, Marcus},
	urldate = {2026-04-23},
	date = {2025-07},
	langid = {english},
	keywords = {Learning algorithms, Neural circuits},
	file = {Full Text PDF:files/212/Greenstreet et al. - 2025 - Dopaminergic action prediction errors serve as a value-free teaching signal.pdf:application/pdf},
}

@article{naude_dopamine_2024,
	title = {Dopamine builds and reveals reward-associated latent behavioral attractors},
	volume = {15},
	rights = {2024 The Author(s)},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-024-53976-x},
	doi = {10.1038/s41467-024-53976-x},
	abstract = {Phasic variations in dopamine levels are interpreted as a teaching signal reinforcing rewarded behaviors. However, behavior also depends on the motivational, neuromodulatory effect of phasic dopamine. In this study, we reveal a neurodynamical principle that unifies these roles in a recurrent network-based decision architecture embodied through an action-perception loop with the task space, the {MAGNet} model. Dopamine optogenetic conditioning in mice was accounted for by an embodied network model in which attractors encode internal goals. Dopamine-dependent synaptic plasticity created “latent” attractors, to which dynamics converged, but only locally. Attractor basins were widened by dopamine-modulated synaptic excitability, rendering goals accessible globally, i.e. from distal positions. We validated these predictions optogenetically in mice: dopamine neuromodulation suddenly and specifically attracted animals toward rewarded locations, without off-target motor effects. We thus propose that motivational dopamine reveals dopamine-built attractors representing potential goals in a behavioral landscape.},
	pages = {9825},
	number = {1},
	journaltitle = {Nature Communications},
	shortjournal = {Nat Commun},
	publisher = {Nature Publishing Group},
	author = {Naudé, Jérémie and Sarazin, Matthieu X. B. and Mondoloni, Sarah and Hannesse, Bernadette and Vicq, Eléonore and Amegandjin, Fabrice and Mourot, Alexandre and Faure, Philippe and Delord, Bruno},
	urldate = {2026-04-22},
	date = {2024-11-13},
	langid = {english},
	keywords = {Motivation, Network models},
	file = {Full Text PDF:files/213/Naudé et al. - 2024 - Dopamine builds and reveals reward-associated latent behavioral attractors.pdf:application/pdf},
}

@article{starkweather_medial_2018,
	title = {Medial prefrontal cortex shapes dopamine reward prediction errors under state uncertainty},
	volume = {98},
	issn = {0896-6273},
	url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC5934341/},
	doi = {10.1016/j.neuron.2018.03.036},
	abstract = {Animals make predictions based on currently available information. In natural settings, sensory cues may not reveal complete information, requiring the animal to infer the ‘hidden state’ of the environment. The brain structures important in hidden state inference remain unknown. A previous study showed that midbrain dopamine neurons exhibit distinct response patterns depending on whether reward is delivered in 100\% (Task 1) or 90\% of trials (Task 2) in a classical conditioning task. Here we found that inactivation of the medial prefrontal cortex ({mPFC}) affected dopaminergic signaling in Task 2, in which the hidden state must be inferred (‘will reward come, or not?’), but not in Task 1, where the state was known with certainty. Computational modeling suggests that the effects of inactivation are best explained by a circuit in which the {mPFC} conveys inference over hidden states to the dopamine system.},
	pages = {616--629.e6},
	number = {3},
	journaltitle = {Neuron},
	shortjournal = {Neuron},
	author = {Starkweather, Clara Kwon and Gershman, Samuel J. and Uchida, Naoshige},
	urldate = {2026-04-20},
	date = {2018-05-02},
	file = {Full Text PDF:files/214/Starkweather et al. - 2018 - Medial prefrontal cortex shapes dopamine reward prediction errors under state uncertainty.pdf:application/pdf},
}

@article{bakhurin_dopamine_2025,
	title = {Dopamine dynamics during stimulus-reward learning in mice can be explained by performance rather than learning},
	volume = {16},
	rights = {2025 The Author(s)},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/s41467-025-64132-4},
	doi = {10.1038/s41467-025-64132-4},
	abstract = {The reward prediction error ({RPE}) hypothesis posits that phasic dopamine ({DA}) activity in the ventral tegmental area ({VTA}) encodes the difference between expected and actual rewards to drive reinforcement learning. However, emerging evidence suggests {DA} may instead regulate behavioral performance. Here, we used force sensors to measure subtle movements in head-fixed mice during a Pavlovian stimulus-reward task, while recording and manipulating {VTA} {DA} activity. We identified distinct {DA} neuron populations tuned to forward and backward force exertion. They are active during both spontaneous and conditioned behaviors, independent of learning or reward predictability. Variations in force and licking fully account for {DA} dynamics traditionally attributed to {RPE}, including variations in firing rates related to reward magnitude, probability, and omission. Optogenetic manipulations further confirmed that {DA} modulates force exertion and behavioral transitions in real time, without affecting learning. Our findings challenge the {RPE} hypothesis and instead suggest that {VTA} {DA} neurons dynamically adjust the gain of motivated behaviors, controlling their latency, direction, and intensity during performance.},
	pages = {9081},
	number = {1},
	journaltitle = {Nature Communications},
	shortjournal = {Nat Commun},
	publisher = {Nature Publishing Group},
	author = {Bakhurin, Konstantin and Hughes, Ryan N. and Jiang, Qiaochu and Hossain, Meghdoot and Gutkin, Boris and Fallon, Isabella P. and Yin, Henry H.},
	urldate = {2026-04-20},
